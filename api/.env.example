# Spring Boot não carrega .env automaticamente; configure no terminal/Portainer.
SPRING_PROFILES_ACTIVE=local,demonstracao,r2,r2-local
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# API executada no Windows.
DB_URL=jdbc:mariadb://127.0.0.1:3306/psa_gestor
DB_USERNAME=psa_app
DB_PASSWORD=
DB_MIGRATIONS_ENABLED=true
CACHE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
